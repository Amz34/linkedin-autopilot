# ─── LinkedIn Tool .env ───
# Save this file as .env (copy it) and fill in your values.

# LinkedIn Developer App credentials (developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# DeepSeek API key (for AI content generation)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Redirect URL (must match the one set in LinkedIn app settings)
REDIRECT_URI=http://localhost:8787/callback
