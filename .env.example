# ─── LinkedIn Tool .env ───
# Is file ko .env naam se save karo (copy karke) aur apni values daalo.

# LinkedIn Developer App ke credentials (developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# DeepSeek API key (AI content generation ke liye)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Redirect URL (LinkedIn app settings mein yehi daalna hai)
REDIRECT_URI=http://localhost:8787/callback
